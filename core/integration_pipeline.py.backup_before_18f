"""
THE_FX.TRADER.BOT.ZW
Stage 14 — Integration Pipeline

Connects signal protection, alerts and journal without
adding trade execution.
"""

from __future__ import annotations

from dataclasses import dataclass


@dataclass
class PipelineResult:
    status: str
    signal: str
    strength: float
    confirmations: int
    journaled: bool
    alerted: bool
    explanation: str


class IntegrationPipeline:

    def __init__(
        self,
        system,
        protected_engine=None,
        alert_dispatcher=None,
    ):
        self.system = system
        self.protected_engine = protected_engine
        self.alert_dispatcher = alert_dispatcher

    def process_signal(self, signal):

        signal_name = str(
            getattr(signal, "signal", "WAIT")
        ).upper()

        strength = float(
            getattr(signal, "strength", 0)
        )

        confirmations = int(
            getattr(signal, "confirmations", 0)
        )

        explanation = str(
            getattr(signal, "explanation", "")
        )

        if self.system.emergency_stop:
            return PipelineResult(
                status="EMERGENCY_STOP",
                signal="WAIT",
                strength=0,
                confirmations=0,
                journaled=False,
                alerted=False,
                explanation="SYSTEM_EMERGENCY_STOP",
            )

        record = self.system.accept_signal(
            signal=signal_name,
            strength=strength,
            confirmations=confirmations,
            entry=getattr(signal, "entry", None),
            stop_loss=getattr(
                signal,
                "stop_loss",
                None,
            ),
            tp1=getattr(signal, "tp1", None),
            tp2=getattr(signal, "tp2", None),
            setup=getattr(
                signal,
                "setup",
                "",
            ),
            explanation=explanation,
        )

        if record is None:
            return PipelineResult(
                status="BLOCKED",
                signal="WAIT",
                strength=0,
                confirmations=0,
                journaled=False,
                alerted=False,
                explanation="SIGNAL_BLOCKED",
            )

        alerted = False

        # Alert dispatch is optional. The existing Stage 10
        # dispatcher remains responsible for Android feedback.
        if (
            self.alert_dispatcher is not None
            and signal_name in {"BUY", "SELL"}
        ):
            try:
                result = self.alert_dispatcher.dispatch(
                    signal
                )

                alerted = bool(result)

            except Exception:
                alerted = False

        return PipelineResult(
            status="PROCESSED",
            signal=signal_name,
            strength=strength,
            confirmations=confirmations,
            journaled=True,
            alerted=alerted,
            explanation=explanation,
        )
