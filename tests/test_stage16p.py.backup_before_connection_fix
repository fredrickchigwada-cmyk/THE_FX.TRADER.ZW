import json
import time
from pathlib import Path

from core.deriv_ws import DerivWebSocket
from core.candle_engine import CandleEngine, Candle
from core.signal_engine import SignalEngine
from core.signal_protection import SignalProtection
from core.signal_lifecycle import SignalLifecycle
from core.candle_close_protection import CandleCloseProtection
from core.persistent_alert_router import PersistentAlertRouter
from core.android_alert_bridge import AndroidAlertBridge
from core.signal_journal import SignalJournal
from core.full_system import FullSystem
from core.integration_pipeline import IntegrationPipeline


SYMBOL = "frxXAUUSD"
TIMEFRAME = "M1"

HISTORY_FILE = Path(
    "data/historical_bootstrap/frxXAUUSD_M1.json"
)

MONITOR_SECONDS = 75


print()
print("=" * 100)
print(" THE_FX.TRADER.BOT.ZW")
print(" STAGE 16P — XAUUSD LIVE ALERT-READY VERIFICATION")
print("=" * 100)
print()

# ================================================================
# COMPONENTS
# ================================================================

candle_engine = CandleEngine()
signal_engine = SignalEngine()
protection = SignalProtection()
lifecycle = SignalLifecycle()
candle_protection = CandleCloseProtection()
alert_router = PersistentAlertRouter()
android_bridge = AndroidAlertBridge()

journal = SignalJournal(
    path=Path("data/signal_history_16p_test.json")
)

system = FullSystem()
pipeline = IntegrationPipeline(system)

print("COMPONENTS")
print("Deriv WebSocket      : ENABLED")
print("XAUUSD                : PRIORITY")
print("Candle engine        : ENABLED")
print("Signal engine        : ENABLED")
print("Candle protection    : ENABLED")
print("Signal protection    : ENABLED")
print("Lifecycle             : ENABLED")
print("Alert router         : ENABLED")
print("Android bridge       : ENABLED")
print("Journal              : ENABLED")
print()

# ================================================================
# HISTORICAL DATA
# ================================================================

if not HISTORY_FILE.exists():
    print("ERROR: XAUUSD historical data missing.")
    raise SystemExit(1)

with HISTORY_FILE.open(
    "r",
    encoding="utf-8"
) as f:
    raw = json.load(f)

if isinstance(raw, dict):
    raw = raw.get(
        "candles",
        raw.get("history", [])
    )

historical = []

for item in raw:

    start = int(
        item.get(
            "start",
            item.get(
                "epoch",
                item.get("time", 0)
            )
        )
    )

    historical.append(
        Candle(
            symbol=SYMBOL,
            timeframe=TIMEFRAME,
            start=start,
            end=start + 60,
            open=float(item["open"]),
            high=float(item["high"]),
            low=float(item["low"]),
            close=float(item["close"]),
            volume=float(
                item.get("volume", 0)
            ),
        )
    )

print(
    f"Historical candles : {len(historical)}"
)

if len(historical) < 200:
    print("ERROR: Less than 200 candles.")
    raise SystemExit(1)

print("Historical data    : READY")
print()

# ================================================================
# LIVE STATE
# ================================================================

tick_count = 0
latest_price = None
latest_epoch = None
connection_open = False


def on_message(data):

    global tick_count
    global latest_price
    global latest_epoch

    if not isinstance(data, dict):
        return

    if data.get("msg_type") != "tick":
        return

    tick = data.get("tick") or {}

    if tick.get("symbol") != SYMBOL:
        return

    try:
        price = float(tick["quote"])
        epoch = float(tick["epoch"])
    except Exception:
        return

    tick_count += 1
    latest_price = price
    latest_epoch = epoch

    try:
        candle_engine.update_tick(
            SYMBOL,
            price,
            epoch,
        )
    except Exception:
        pass

    if tick_count <= 5:
        print(
            f"[TICK {tick_count:03d}] "
            f"XAUUSD = {price}"
        )


def on_open():
    global connection_open
    connection_open = True
    print("[DERIV] WebSocket OPEN")


def on_close():
    global connection_open
    connection_open = False
    print("[DERIV] WebSocket CLOSED")


# ================================================================
# CONNECT
# ================================================================

print("CONNECTING TO DERIV")
print()

ws = DerivWebSocket(
    on_message=on_message,
)

# Use the existing callback interface.
ws.on_message_callback = on_message

try:

    ws.connect()

    print("Connection request : SENT")

except Exception as exc:

    print(
        f"Connection failed : {exc}"
    )

    raise SystemExit(1)

# ================================================================
# XAUUSD SUBSCRIPTION WITH RETRY
# ================================================================

print()
print("XAUUSD LIVE SUBSCRIPTION")
print()

subscribed = False

for attempt in range(1, 5):

    try:

        print(
            f"Subscription attempt {attempt}/4..."
        )

        ws.subscribe_ticks(SYMBOL)

        subscribed = True

        print("XAUUSD subscription : SENT")

        break

    except Exception as exc:

        print(
            f"Attempt {attempt} failed : {exc}"
        )

        if attempt < 4:
            time.sleep(5)

if not subscribed:

    print()
    print("XAUUSD subscription could not be established.")
    print("STAGE 16P: REVIEW REQUIRED")

    try:
        ws.stop()
    except Exception:
        pass

    raise SystemExit(1)

# ================================================================
# LIVE MONITOR
# ================================================================

print()
print(
    f"Monitoring XAUUSD for {MONITOR_SECONDS} seconds..."
)
print()

deadline = time.time() + MONITOR_SECONDS

while time.time() < deadline:
    time.sleep(1)

# ================================================================
# LIVE DATA RESULT
# ================================================================

print()
print("=" * 100)
print(" XAUUSD LIVE DATA")
print("=" * 100)

print(
    f"Ticks received : {tick_count}"
)
print(
    f"Latest price   : {latest_price}"
)
print(
    f"Latest epoch   : {latest_epoch}"
)

current_candle = candle_engine.get_current(
    SYMBOL,
    TIMEFRAME,
)

print(
    f"Current candle : "
    f"{'YES' if current_candle else 'NO'}"
)

if tick_count == 0:

    print()
    print("No XAUUSD ticks received.")
    print("XAUUSD live verification cannot continue.")

    try:
        ws.stop()
    except Exception:
        pass

    raise SystemExit(1)

# ================================================================
# BUILD ANALYSIS DATA
# ================================================================

candles = list(historical)

if current_candle is not None:

    if candles and candles[-1].start == current_candle.start:
        candles[-1] = current_candle
    else:
        candles.append(current_candle)

# ================================================================
# SIGNAL
# ================================================================

print()
print("=" * 100)
print(" XAUUSD SIGNAL")
print("=" * 100)

signal = signal_engine.generate(
    SYMBOL,
    TIMEFRAME,
    candles,
)

print(
    f"Direction     : {signal.direction}"
)
print(
    f"Strength      : {signal.strength}/10"
)
print(
    f"Confirmations : {signal.confirmations}"
)
print(
    f"Entry         : {signal.entry}"
)
print(
    f"Stop Loss     : {signal.stop_loss}"
)
print(
    f"TP1           : {signal.tp1}"
)
print(
    f"TP2           : {signal.tp2}"
)
print(
    f"Invalidation  : {signal.invalidation}"
)
print(
    f"Candle confirm: {signal.candle_confirmed}"
)
print(
    f"Valid         : {signal.valid}"
)
print(
    f"Explanation   : {signal.explanation}"
)

# ================================================================
# CANDLE PROTECTION
# ================================================================

print()
print("CANDLE-CLOSE PROTECTION")

confirmed, reason = candle_protection.validate(
    signal,
    current_candle,
)

print(
    f"Confirmed : {confirmed}"
)
print(
    f"Reason    : {reason}"
)

# ================================================================
# PROTECTION + LIFECYCLE
# ================================================================

protected = None
alerted = False
journaled = False

if (
    signal.valid
    and signal.direction in ("BUY", "SELL")
    and confirmed
):

    print()
    print("SIGNAL PROTECTION")

    try:

        protected = protection.emit(
            signal
        )

        print(
            "Protection : PASSED"
        )

        lifecycle.signal_created(
            protected
        )

        lifecycle.signal_active(
            protected
        )

        print(
            "Lifecycle   : ACTIVE"
        )

    except Exception as exc:

        print(
            f"Protection : FAILED — {exc}"
        )

        raise SystemExit(1)

    # ------------------------------------------------------------
    # ALERT
    # ------------------------------------------------------------

    print()
    print("ALERT ROUTING")

    try:

        alert_result = alert_router.route(
            signal,
            now=time.time(),
        )

        alerted = bool(alert_result)

        print(
            f"Alert routed : {alerted}"
        )

    except Exception as exc:

        print(
            f"Alert router error : {exc}"
        )

        raise SystemExit(1)

    # ------------------------------------------------------------
    # JOURNAL
    # ------------------------------------------------------------

    print()
    print("JOURNAL")

    try:

        journal.add(
            symbol=signal.symbol,
            timeframe=signal.timeframe,
            signal=signal.direction,
            strength=signal.strength,
            confirmations=signal.confirmations,
            entry=signal.entry,
            stop_loss=signal.stop_loss,
            tp1=signal.tp1,
            tp2=signal.tp2,
            result="PENDING",
            setup="STAGE_16P_LIVE_XAUUSD",
            notes=signal.explanation,
        )

        journaled = True

        print("Journal : PASSED")

    except Exception as exc:

        print(
            f"Journal : FAILED — {exc}"
        )

        raise SystemExit(1)

else:

    print()
    print(
        "Directional signal did not pass "
        "all protection requirements."
    )

    print(
        "No alert emitted."
    )

    print(
        "No protected signal created."
    )

# ================================================================
# STOP
# ================================================================

try:
    ws.stop()
except Exception:
    pass

# ================================================================
# FINAL SUMMARY
# ================================================================

print()
print("=" * 100)
print(" STAGE 16P SUMMARY")
print("=" * 100)

print(
    f"XAUUSD ticks       : {tick_count}"
)

print(
    f"Live candle        : "
    f"{'YES' if current_candle else 'NO'}"
)

print(
    f"Signal             : {signal.direction}"
)

print(
    f"Strength           : {signal.strength}/10"
)

print(
    f"Candle protection  : "
    f"{'PASSED' if confirmed else 'BLOCKED'}"
)

print(
    f"Protected signal   : "
    f"{'YES' if protected else 'NO'}"
)

print(
    f"Alert routed       : "
    f"{alerted}"
)

print(
    f"Journaled          : "
    f"{journaled}"
)

print()
print("Automatic trading : DISABLED")
print("Trade execution   : DISABLED")
print("Signal-only mode  : ENABLED")
print("XAUUSD priority    : ENABLED")
print("Data source        : Deriv")
print("Termux session     : REMAINS OPEN")

print()
print("=" * 100)

if tick_count > 0:
    print("STAGE 16P: PASSED")
else:
    print("STAGE 16P: REVIEW REQUIRED")

print("=" * 100)
